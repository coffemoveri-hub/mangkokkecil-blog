---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-[#1A1E1B] border-t border-brand-sage/20 dark:border-brand-sage/10 pt-16 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-12 border-b border-brand-sage/20 dark:border-brand-sage/10">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-2xl bg-brand-sage-soft dark:bg-brand-sage/20 border border-brand-sage/30 flex items-center justify-center">
            <svg class="w-6 h-6 text-brand-sage-dark dark:text-brand-sage-light" viewBox="0 0 64 64" fill="none">
              <path d="M16 28 C16 46, 48 46, 48 28 Z" fill="#A3B18A" />
              <ellipse cx="32" cy="28" rx="16" ry="3.5" fill="#588157" />
              <path d="M26 43 L38 43 L36 46 L28 46 Z" fill="#588157" />
              <path d="M24 16 C28 20, 38 27, 44 26 C45 23, 41 18, 32 17 Z" fill="#FF9F1C" />
            </svg>
          </div>
          <span class="font-display font-extrabold text-2xl tracking-tight text-brand-charcoal dark:text-gray-100">
            Mangkok<span class="text-brand-orange">Kecil</span>
          </span>
        </a>

        <p class="text-sm text-brand-charcoal/80 dark:text-gray-300 leading-relaxed max-w-sm">
          Platform edukasi nutrisi MPASI terpercaya untuk ibu muda dan keluarga Indonesia. Membantu si Kecil makan lahap, tumbuh kembang optimal sesuai panduan IDAI & WHO, bebas drama GTM.
        </p>

        <!-- Social Badges -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram MangkokKecil"
            class="w-9 h-9 rounded-full bg-brand-sage-soft dark:bg-zinc-800 text-brand-charcoal dark:text-gray-200 flex items-center justify-center hover:bg-brand-orange hover:text-white transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a
            href="https://tiktok.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok MangkokKecil"
            class="w-9 h-9 rounded-full bg-brand-sage-soft dark:bg-zinc-800 text-brand-charcoal dark:text-gray-200 flex items-center justify-center hover:bg-brand-orange hover:text-white transition-colors"
