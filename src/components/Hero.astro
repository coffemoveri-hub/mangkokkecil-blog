---
---

<section class="relative overflow-hidden pt-10 pb-16 lg:pt-16 lg:pb-24">
  <!-- Subtle Organic Background Blobs -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full overflow-hidden -z-10 pointer-events-none opacity-40 dark:opacity-20">
    <div class="absolute -top-24 -left-20 w-96 h-96 rounded-full bg-brand-sage-light/40 blur-3xl"></div>
    <div class="absolute top-1/3 -right-24 w-80 h-80 rounded-full bg-brand-orange-soft blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Column (H1 & CTAs) -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Top Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-sage-soft dark:bg-brand-sage/20 border border-brand-sage/30 text-brand-sage-dark dark:text-brand-sage-light text-xs sm:text-sm font-bold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-ping"></span>
          <span>Panduan Terpercaya Sesuai Standar IDAI & WHO</span>
        </div>

        <!-- Single H1: NAMA_MEDIA + PRODUK -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-charcoal dark:text-gray-100 tracking-tight leading-[1.15]">
          Edukasi & Resep <span class="text-brand-orange underline decoration-brand-sage/40 decoration-wavy decoration-2">MPASI</span> Terlengkap Bersama <span class="text-brand-sage-dark dark:text-brand-sage-light">MangkokKecil</span>
        </h1>

        <!-- Subheading for Target Audience -->
        <p class="text-lg sm:text-xl text-brand-charcoal/80 dark:text-gray-300 leading-relaxed max-w-2xl mx-auto lg:mx-0 font-normal">
          Dampingi si Kecil usia 4–24 bulan tumbuh sehat & cerdas. Dari tahapan tekstur awal 6 bulan, menu padat zat besi pencegah stunting, meal prep praktis ibu bekerja, hingga strategi feeding rules hadapi fase GTM.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="/blog"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-brand-orange hover:bg-brand-orange-hover text-white text-base font-bold shadow-warm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <span>Jelajahi Resep MPASI</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>

          <a
            href="/panduan"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-white dark:bg-brand-charcoal/60 text-brand-charcoal dark:text-gray-200 border-2 border-brand-sage/40 hover:border-brand-sage hover:bg-brand-sage-soft/30 text-base font-bold transition-all duration-300 shadow-sm"
          >
            <span>Panduan Tekstur Usia</span>
          </a>
        </div>

        <!-- Quick Trust Signals -->
        <div class="pt-6 border-t border-brand-sage/20 dark:border-brand-sage/10 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0">
          <div>
            <p class="font-display text-2xl font-bold text-brand-orange">100%</p>
            <p class="text-xs text-brand-charcoal-muted dark:text-gray-400">Bahan Alami & Padat Gizi</p>
          </div>
          <div>
            <p class="font-display text-2xl font-bold text-brand-sage-dark dark:text-brand-sage-light">6-24</p>
            <p class="text-xs text-brand-charcoal-muted dark:text-gray-400">Bulan Tahapan Tekstur</p>
          </div>
          <div>
            <p class="font-display text-2xl font-bold text-brand-charcoal dark:text-gray-200">Bebas</p>
            <p class="text-xs text-brand-charcoal-muted dark:text-gray-400">Stres Hadapi GTM</p>
          </div>
        </div>

      </div>

      <!-- Visual Column (Organic Illustration & Mockup Cards) -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-md">
          
          <!-- Main Hero Image Frame -->
          <div class="relative rounded-organic overflow-hidden border-4 border-white dark:border-zinc-800 shadow-organic-lg bg-brand-sage-soft">
            <img
              src="https://images.unsplash.com/photo-1598515214211-89d3c73ae83b?auto=format&fit=crop&w=800&q=80"
              alt="Mangkuk Puree MPASI Sehat dan Bergizi MangkokKecil"
              width="600"
              height="600"
              loading="eager"
              class="w-full h-80 sm:h-96 object-cover hover:scale-105 transition-transform duration-700"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-6">
              <div class="text-white">
                <span class="inline-block px-3 py-1 rounded-full bg-brand-orange text-xs font-bold mb-2">Resep Favorit</span>
                <p class="font-display font-bold text-lg leading-snug">Puree Labu Kuning & Hati Ayam (Cegah Anemia)</p>
              </div>
            </div>
          </div>

          <!-- Floating Badge 1: Anti GTM -->
          <div class="absolute -bottom-6 -left-6 bg-white dark:bg-zinc-800 p-4 rounded-2xl shadow-organic border border-brand-sage/20 flex items-center gap-3 animate-float-slow">
            <div class="w-10 h-10 rounded-full bg-brand-orange/20 flex items-center justify-center text-brand-orange">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-brand-charcoal dark:text-gray-100">Formula Anti-GTM</p>
              <p class="text-[11px] text-brand-charcoal-muted dark:text-gray-400">Aturan Makan 30 Menit</p>
            </div>
          </div>

          <!-- Floating Badge 2: Verified IDAI -->
          <div class="hidden sm:flex absolute -top-4 -right-4 bg-white dark:bg-zinc-800 p-3.5 rounded-2xl shadow-organic border border-brand-sage/20 items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-brand-sage/20 flex items-center justify-center text-brand-sage-dark dark:text-brand-sage-light">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-xs font-bold text-brand-charcoal dark:text-gray-100">Standar Medis IDAI</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
