---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 px-1">
  <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-brand-charcoal-muted dark:text-gray-400">
    <li class="inline-flex items-center">
      <a
        href="/"
        class="inline-flex items-center gap-1 text-brand-charcoal/80 dark:text-gray-300 hover:text-brand-orange transition-colors font-medium"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
        </svg>
        <span>Beranda</span>
      </a>
    </li>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="inline-flex items-center gap-1.5 sm:gap-2">
          <svg class="w-3.5 h-3.5 text-brand-sage dark:text-brand-sage-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          {isLast || !item.url ? (
            <span class="font-semibold text-brand-sage-dark dark:text-brand-sage-light line-clamp-1 max-w-[220px] sm:max-w-md" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a
              href={item.url}
              class="text-brand-charcoal/80 dark:text-gray-300 hover:text-brand-orange transition-colors font-medium"
            >
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
