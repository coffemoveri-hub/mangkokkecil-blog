---
const navItems = [
  { name: 'Beranda', href: '/' },
  { name: 'Artikel & Resep', href: '/blog' },
  { name: 'Panduan MPASI', href: '/panduan' },
  { name: 'Tentang Kami', href: '/about' },
];

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 transition-all duration-300 glass-effect border-b border-brand-sage/20 dark:border-brand-sage/10 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-orange rounded-xl p-1">
        <div class="w-11 h-11 rounded-2xl bg-brand-sage-soft dark:bg-brand-sage/20 border border-brand-sage/30 flex items-center justify-center shadow-inner group-hover:scale-105 transition-transform">
          <svg class="w-7 h-7 text-brand-sage-dark dark:text-brand-sage-light" viewBox="0 0 64 64" fill="none">
            <path d="M16 28 C16 46, 48 46, 48 28 Z" fill="#A3B18A" />
            <ellipse cx="32" cy="28" rx="16" ry="3.5" fill="#588157" />
            <path d="M26 43 L38 43 L36 46 L28 46 Z" fill="#588157" />
            <path d="M24 16 C28 20, 38 27, 44 26 C45 23, 41 18, 32 17 Z" fill="#FF9F1C" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-display font-extrabold text-2xl tracking-tight text-brand-charcoal dark:text-gray-100 group-hover:text-brand-orange transition-colors">
            Mangkok<span class="text-brand-orange">Kecil</span>
          </span>
          <span class="text-[11px] font-semibold text-brand-sage-dark dark:text-brand-sage-light tracking-wider uppercase -mt-1">
            Sahabat MPASI Si Kecil
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navItems.map((item) => {
          const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 ${
                isActive
                  ? 'bg-brand-sage text-white shadow-organic'
                  : 'text-brand-charcoal dark:text-gray-200 hover:text-brand-orange hover:bg-brand-orange-soft/40 dark:hover:bg-gray-800'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Action Buttons & Dark Mode Toggle -->
      <div class="flex items-center gap-3">
        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Ganti mode gelap/terang"
          class="p-2.5 rounded-full text-brand-charcoal/80 dark:text-gray-300 hover:bg-brand-sage-soft dark:hover:bg-gray-800 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-orange"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg id="theme-toggle-light-icon" class="hidden w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd" />
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5 text-brand-charcoal" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
        </button>

        <!-- CTA Button Desktop -->
        <a
          href="/blog#gtm-solusi"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-brand-orange hover:bg-brand-orange-hover text-white text-sm font-bold shadow-warm hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5"
        >
          <span>Penyelamat GTM</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Buka menu navigasi"
          class="md:hidden p-2.5 rounded-2xl text-brand-charcoal dark:text-gray-200 hover:bg-brand-sage-soft dark:hover:bg-gray-800 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-3 pb-6 border-t border-brand-sage/20 dark:border-brand-sage/10 bg-brand-cream/98 dark:bg-zinc-900/98 transition-all">
    <div class="flex flex-col gap-2">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-4 py-3 rounded-2xl text-base font-semibold transition-all ${
              isActive
                ? 'bg-brand-sage text-white'
                : 'text-brand-charcoal dark:text-gray-200 hover:bg-brand-sage-soft dark:hover:bg-gray-800'
            }`}
          >
            {item.name}
          </a>
        );
      })}
      <a
        href="/blog"
        class="mt-2 text-center py-3 rounded-2xl bg-brand-orange text-white font-bold shadow-warm"
      >
        Menu Penyelamat GTM
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Logic
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Theme Toggle Logic
  const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
  const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
  const themeToggleBtn = document.getElementById('theme-toggle');

  if (
    localStorage.getItem('color-theme') === 'dark' ||
    (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
  ) {
    themeToggleLightIcon?.classList.remove('hidden');
    document.documentElement.classList.add('dark');
  } else {
    themeToggleDarkIcon?.classList.remove('hidden');
    document.documentElement.classList.remove('dark');
  }

  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', function () {
      themeToggleDarkIcon?.classList.toggle('hidden');
      themeToggleLightIcon?.classList.toggle('hidden');

      if (localStorage.getItem('color-theme')) {
        if (localStorage.getItem('color-theme') === 'light') {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        } else {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        }
      } else {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
      }
    });
  }
</script>
