---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedBlogPosts } from '../../lib/notion';

const posts = await getPublishedBlogPosts();

// Ambil semua tag unik dari post
const allTags = ['Semua', ...new Set(posts.flatMap((p) => p.tags))];

const metaDescription = "Kumpulan resep MPASI bergizi, panduan tekstur 6-24 bulan, tips feeding rules IDAI anti-GTM, dan review perlengkapan makan bayi di MangkokKecil.";
---

<Layout
  title="Artikel & Resep MPASI Terlengkap"
  description={metaDescription}
  breadcrumbs={[{ name: 'Artikel & Resep', url: '/blog' }]}
  type="website"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ name: 'Artikel & Resep', url: '/blog' }]} />

    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto mt-6 mb-12 space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-brand-sage-soft dark:bg-brand-sage/20 text-brand-sage-dark dark:text-brand-sage-light text-xs font-bold uppercase tracking-wider">
        Katalog MPASI MangkokKecil
      </span>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-charcoal dark:text-gray-100">
        Inspirasi Resep & Edukasi Nutrisi Bayi
      </h1>
      <p class="text-base text-brand-charcoal/80 dark:text-gray-300">
        Temukan panduan lengkap MPASI dari tekstur awal hingga tips feeding rules anti-GTM yang telah tervalidasi secara medis untuk buah hati Anda.
      </p>

      <!-- Search Input Filter -->
      <div class="pt-4 max-w-md mx-auto">
        <div class="relative">
          <input
            type="text"
            id="blog-search"
            placeholder="Cari resep, bahan (hati ayam, labu), atau topik GTM..."
            class="w-full pl-11 pr-4 py-3 rounded-full border border-brand-sage/30 dark:border-brand-sage/20 bg-white dark:bg-zinc-800 text-sm focus:outline-none focus:ring-2 focus:ring-brand-orange shadow-sm"
          />
          <svg class="w-5 h-5 text-brand-charcoal-muted absolute left-4 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Tag Filter Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-4" id="tag-filters">
        {allTags.map((tag, idx) => (
          <button
            type="button"
            data-tag={tag}
            class={`tag-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all ${
              idx === 0
                ? 'bg-brand-orange text-white shadow-warm active-tag'
                : 'bg-white dark:bg-zinc-800 text-brand-charcoal/80 dark:text-gray-300 border border-brand-sage/20 hover:border-brand-orange hover:text-brand-orange'
            }`}
          >
            {tag}
          </button>
        ))}
      </div>

    </div>

    <!-- Responsive Post Grid -->
    <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <div class="post-card-wrapper" data-tags={post.tags.join(',')} data-title={post.title.toLowerCase()} data-excerpt={post.excerpt.toLowerCase()}>
          <BlogCard post={post} />
        </div>
      ))}
    </div>

    <!-- No results state -->
    <div id="no-results" class="hidden text-center py-16 space-y-4">
      <div class="w-16 h-16 rounded-full bg-brand-sage-soft dark:bg-zinc-800 text-brand-sage-dark mx-auto flex items-center justify-center">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="font-display text-xl font-bold text-brand-charcoal dark:text-gray-100">Artikel Tidak Ditemukan</h3>
      <p class="text-sm text-brand-charcoal-muted max-w-sm mx-auto">
        Coba gunakan kata kunci pencarian yang lain atau pilih kategori "Semua" di atas.
      </p>
    </div>

  </div>
</Layout>

<script>
  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  const tagBtns = document.querySelectorAll('.tag-btn');
  const postWrappers = document.querySelectorAll('.post-card-wrapper');
  const noResults = document.getElementById('no-results');

  let currentTag = 'Semua';
  let searchQuery = '';

  function filterPosts() {
    let visibleCount = 0;

    postWrappers.forEach((el) => {
      const element = el as HTMLElement;
      const tags = element.getAttribute('data-tags') || '';
      const title = element.getAttribute('data-title') || '';
      const excerpt = element.getAttribute('data-excerpt') || '';

      const matchesTag = currentTag === 'Semua' || tags.toLowerCase().includes(currentTag.toLowerCase());
      const matchesSearch = !searchQuery || title.includes(searchQuery) || excerpt.includes(searchQuery);

      if (matchesTag && matchesSearch) {
        element.classList.remove('hidden');
        visibleCount++;
      } else {
        element.classList.add('hidden');
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  // Handle Search Input
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterPosts();
  });

  // Handle Tag Buttons
  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tagBtns.forEach((b) => {
        b.classList.remove('bg-brand-orange', 'text-white', 'shadow-warm', 'active-tag');
        b.classList.add('bg-white', 'dark:bg-zinc-800', 'text-brand-charcoal/80', 'dark:text-gray-300');
      });

      btn.classList.add('bg-brand-orange', 'text-white', 'shadow-warm', 'active-tag');
      btn.classList.remove('bg-white', 'dark:bg-zinc-800', 'text-brand-charcoal/80', 'dark:text-gray-300');

      currentTag = btn.getAttribute('data-tag') || 'Semua';
      filterPosts();
    });
  });
</script>
